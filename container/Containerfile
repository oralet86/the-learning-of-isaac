# Isaac environment image: Wine + Xvfb + Mesa (software or GPU via VirtualGL) + sidecar
#
# Build with `python -m container.build` from the repository root: it supplies
# the build arguments below from the same constants the Python code uses.
FROM python:3.14-slim-trixie

ENV DEBIAN_FRONTEND=noninteractive \
    WINEPREFIX=/opt/prefix \
    WINEARCH=win32 \
    WINEDEBUG=-all \
    PYTHONUNBUFFERED=1

# isaac-ng.exe is PE32 (32-bit): 32-bit Wine only, no wine64
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y --no-install-recommends \
        wine wine32:i386 \
        xvfb x11-utils xdotool \
        libgl1 libgl1:i386 libegl1 libegl1:i386 \
        libgl1-mesa-dri libgl1-mesa-dri:i386 libglx-mesa0 libglx-mesa0:i386 \
        ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*

# VirtualGL redirects the game's OpenGL rendering to a GPU render node while
# it keeps drawing into the Xvfb window, which has no hardware GL of its own.
# Only used when the container is started with a GPU device (see GPU_DEVICE).
# Debian does not package it; the upstream packages are pinned by checksum.
ADD --checksum=sha256:df3f7788ce41b182a47c0d298e5cd6d2d63579522cb41825970b7726e825485e \
    https://github.com/VirtualGL/virtualgl/releases/download/3.1.5/virtualgl_3.1.5_amd64.deb \
    /tmp/virtualgl.deb
ADD --checksum=sha256:7dc63ecb47d7ab9cb486bb21a9a968dee853380da760cc7f36f616d09ec62b9e \
    https://github.com/VirtualGL/virtualgl/releases/download/3.1.5/virtualgl32_3.1.5_amd64.deb \
    /tmp/virtualgl32.deb
RUN apt-get update && apt-get install -y --no-install-recommends \
        /tmp/virtualgl.deb /tmp/virtualgl32.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/virtualgl.deb /tmp/virtualgl32.deb

# Sidecar runtime dependencies (the sidecar itself is copied at the end)
RUN pip install --no-cache-dir python-xlib numpy

# Bake the Wine prefix into the image so it is never created at runtime.
# This needs an X server only for the duration of the build step; the display
# number here is unrelated to the one the sidecar uses at runtime.
# Xvfb's lock file and socket dir are removed so they are not baked into the
# layer. mscoree/mshtml are disabled so wineboot doesn't block on Mono/Gecko
# install prompts.
RUN Xvfb :1 -nolisten tcp & XPID=$!; sleep 2; \
    DISPLAY=:1 WINEDLLOVERRIDES="mscoree,mshtml=" wineboot --init && wineserver -w; \
    status=$?; kill $XPID; wait $XPID; \
    rm -rf /tmp/.X1-lock /tmp/.X11-unix /tmp/wine-*; exit $status

ENV WINEDLLOVERRIDES="mscoree,mshtml="

# Supplied by container/build.py; there are deliberately no defaults here.
ARG APP_DIR
ARG GAME_DIR
ARG SAVE_SOURCE_DIR
ARG SIDECAR_PORT
RUN test -n "${APP_DIR}" && test -n "${GAME_DIR}" \
    && test -n "${SAVE_SOURCE_DIR}" && test -n "${SIDECAR_PORT}" \
    || { echo "missing build args: build with 'python -m container.build'" >&2; exit 1; }

# Your Steam-less game copy, kept in the repo as container/isaac/
COPY container/isaac/ ${GAME_DIR}/

# Fully unlocked save, kept as container/save/ (exactly one .dat). The sidecar
# installs it into the game's save slot before every launch.
COPY container/save/ ${SAVE_SOURCE_DIR}/

# Sidecar sources last, so editing them does not invalidate the game layer.
# They keep their repo import paths (constants, container.sidecar).
COPY constants.py ${APP_DIR}/constants.py
COPY container/__init__.py ${APP_DIR}/container/__init__.py
COPY container/sidecar/ ${APP_DIR}/container/sidecar/

WORKDIR ${APP_DIR}
EXPOSE ${SIDECAR_PORT}
ENTRYPOINT ["python3", "-m", "container.sidecar"]
