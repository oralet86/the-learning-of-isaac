{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "python": {
      "command": [".venv/bin/pyright-langserver", "--stdio"],
      "extensions": [".py"]
    }
  },
  "formatter": {
    "python": {
      "command": [".venv/bin/ruff", "format", "-"],
      "extensions": [".py"]
    }
  },
  "permission": {
    "lsp": "allow"
  }
}
